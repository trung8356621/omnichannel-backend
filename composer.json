{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bezhansalleh/filament-language-switch": "^3.1",
        "filament/filament": "^3.2",
        "intervention/image-laravel": "^4.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.24",
        "laravel/tinker": "^2.10.1",
        "mozex/anthropic-laravel": "^1.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.3",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Addons\\SeoContentAi\\Tests\\": "app/Addons/SeoContentAi/tests/",
            "Omnichannel\\Addons\\SearchFoundation\\": "addons/search-foundation/src/",
            "Omnichannel\\Addons\\Seo\\": "addons/seo/src/",
            "Omnichannel\\Addons\\SearchIntelligence\\": "addons/search-intelligence/src/",
            "Omnichannel\\Addons\\AiPrompt\\": "addons/ai-prompt/src/",
            "Omnichannel\\Addons\\Content\\": "addons/content/src/",
            "Omnichannel\\Addons\\ContentProjects\\": "addons/content-projects/src/",
            "Omnichannel\\Addons\\Media\\": "addons/media/src/",
            "Omnichannel\\Addons\\WordPress\\": "addons/wordpress/src/",
            "Omnichannel\\Addons\\Publishing\\": "addons/publishing/src/",
            "Omnichannel\\Addons\\SiteSync\\": "addons/site-sync/src/",
            "Omnichannel\\Addons\\Agent\\": "addons/agent/src/",
            "Omnichannel\\Addons\\Social\\": "addons/social/src/",
            "Omnichannel\\Addons\\Commerce\\": "addons/commerce/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Omnichannel\\Addons\\Content\\Tests\\": "addons/content/tests/",
            "Omnichannel\\Addons\\Media\\Tests\\": "addons/media/tests/",
            "Omnichannel\\Addons\\Seo\\Tests\\": "addons/seo/tests/",
            "Omnichannel\\Addons\\WordPress\\Tests\\": "addons/wordpress/tests/",
            "Omnichannel\\Addons\\Publishing\\Tests\\": "addons/publishing/tests/",
            "Omnichannel\\Addons\\ContentProjects\\Tests\\": "addons/content-projects/tests/",
            "Omnichannel\\Addons\\SearchIntelligence\\Tests\\": "addons/search-intelligence/tests/",
            "Omnichannel\\Addons\\AiPrompt\\Tests\\": "addons/ai-prompt/tests/",
            "Omnichannel\\Addons\\SiteSync\\Tests\\": "addons/site-sync/tests/",
            "Omnichannel\\Addons\\Agent\\Tests\\": "addons/agent/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/run-phpunit.php"
        ],
        "test:doctor": [
            "@php scripts/test-doctor.php"
        ],
        "test:ci": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/test-doctor.php",
            "@php scripts/run-phpunit.php"
        ],
        "test:artisan": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
