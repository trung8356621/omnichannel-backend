{
  "spec_version": "0.1",
  "key": "article.faq.generate",
  "version": "0.1.0",
  "name": "Generate FAQ content",
  "description": "NORMALIZE_NOW — AI FAQ text/JSON only. Domain persist stays in caller/Business Action.",
  "enabled": true,
  "status": "experimental",
  "model": {
    "provider": "prompt_connection",
    "name": "configured",
    "structured_output": true,
    "settings": {}
  },
  "locale": { "mode": "site", "fallback": "en" },
  "input_schema": {
    "title": { "type": "string", "required": false, "nullable": true },
    "content_excerpt": { "type": "string", "required": false, "nullable": true, "max_length": 100000 },
    "language": { "type": "string", "required": false, "nullable": true }
  },
  "output_schema": {
    "type": "json",
    "normalize": ["trim", "strip_markdown_fence"],
    "validation": { "not_empty": true, "json_object": true }
  },
  "template": {
    "system": "Return FAQ as JSON array. Language: {{language}}.",
    "user": "Title: {{title}}\nContent:\n{{content_excerpt}}"
  },
  "retry": { "max": 0 },
  "logging": { "store_full_prompt": false, "redact_sensitive": true },
  "side_effects": [],
  "strict_template_variables": false
}
