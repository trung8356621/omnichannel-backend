{
  "spec_version": "0.1",
  "key": "article.locale.aware",
  "version": "1.0",
  "name": "Locale-aware prompt variable contract",
  "description": "Documents {{language}} via PromptLanguageVariableService — English language name.",
  "enabled": true,
  "classification": "NORMALIZE_NOW",
  "legacy_binding": "PromptRunnerService merges PromptLanguageVariableService",
  "model": { "provider": "prompt_connection", "name": "configured", "settings": {} },
  "locale": { "mode": "article", "fallback": "en" },
  "input_schema": {
    "language": { "type": "string", "required": true, "allowed_source": ["PromptLanguageVariableService"] },
    "article_language": { "type": "string", "required": false, "nullable": true }
  },
  "output_schema": { "type": "text", "validation": { "not_empty": false } },
  "template": {
    "system": "Write in {{language}}.",
    "user": "Content request for language {{language}}."
  },
  "validation": {},
  "retry": { "max": 0 },
  "logging": { "store_full_prompt": false, "redact_sensitive": true },
  "permissions": { "capability": "text" },
  "metadata": {
    "prompt_concern": "locale instruction",
    "workflow_concern": "variable merge before compile",
    "domain_action_concern": "none",
    "ui_concern": "site/article language settings"
  },
  "side_effects": [],
  "inconsistencies": ["language English name vs slug", "hardcoded VI defaults in SeoPromptSettingsService tone"]
}
