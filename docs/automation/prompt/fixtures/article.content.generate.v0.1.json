{
  "spec_version": "0.1",
  "key": "article.content.generate",
  "version": "0.1.0",
  "status": "experimental",
  "name": "Generate article content",
  "description": "Generate a complete SEO article from structured planning inputs using the current Prompt record as template.",
  "enabled": true,
  "classification": "NORMALIZE_NOW",
  "legacy_binding": "publish_article_task_id → TaskWorkflowTestRunner prompt nodes",
  "model": { "provider": "prompt_connection", "name": "configured", "settings": { "temperature": 0.6 } },
  "locale": { "mode": "site", "fallback": "en" },
  "input_schema": {
    "input": { "type": "string", "required": true, "nullable": false, "max_length": 120000, "allowed_source": ["runtime", "previous_outputs", "task"] },
    "post_title": { "type": "string", "required": false, "nullable": true, "max_length": 500 },
    "focus_keyword": { "type": "string", "required": false, "nullable": true, "max_length": 500 },
    "site_short_description": { "type": "string", "required": false, "nullable": true, "max_length": 8000 },
    "tone": { "type": "string", "required": false, "nullable": true, "max_length": 500 },
    "article_length": { "type": "integer", "required": false, "nullable": true, "minimum": 300, "maximum": 20000 },
    "keyword_density": { "type": "string", "required": false, "nullable": true, "max_length": 100 },
    "site_cta": { "type": "string", "required": false, "nullable": true, "max_length": 5000 },
    "language": { "type": "string", "required": false, "nullable": true, "max_length": 100 },
    "search_intent": { "type": "string", "required": false, "nullable": true, "max_length": 1000 }
  },
  "output_schema": {
    "type": "markdown",
    "validation": { "not_empty": true, "minimum_length": 300, "reject_task_markers": false, "reject_provider_preamble": true },
    "normalize": ["trim", "strip_markdown_fence"]
  },
  "template": { "source": "legacy_prompt_content", "system": null, "user": null },
  "validation": { "not_empty": true },
  "retry": { "max": 1, "on": ["empty", "provider_timeout", "truncated"] },
  "logging": { "store_full_prompt": false, "redact_sensitive": true },
  "permissions": { "capability": "text" },
  "metadata": {
    "prompt_concern": "full article generation",
    "workflow_concern": "consume planning outputs and expose article markdown",
    "domain_action_concern": "article persistence belongs to workflow action",
    "ui_concern": "Prompt Editor and Workflow Prompt block"
  },
  "side_effects": []
}
