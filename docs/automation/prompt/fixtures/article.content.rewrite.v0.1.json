{
  "spec_version": "0.1",
  "key": "article.content.rewrite",
  "version": "0.1.0",
  "status": "experimental",
  "name": "Rewrite article content",
  "description": "Rewrite an existing article using explicit revision instructions while preserving source facts and search intent.",
  "enabled": true,
  "classification": "NORMALIZE_NOW",
  "legacy_binding": "rewrite_article_task_id → TaskTestInputResolver → article.content.update",
  "model": { "provider": "prompt_connection", "name": "configured", "settings": { "temperature": 0.5 } },
  "locale": { "mode": "site", "fallback": "en" },
  "input_schema": {
    "input": { "type": "string", "required": true, "nullable": false, "max_length": 160000, "allowed_source": ["runtime", "task", "previous_outputs"] },
    "rewrite_instruction": { "type": "string", "required": false, "nullable": true, "max_length": 12000 },
    "post_title": { "type": "string", "required": false, "nullable": true, "max_length": 500 },
    "focus_keyword": { "type": "string", "required": false, "nullable": true, "max_length": 500 },
    "site_short_description": { "type": "string", "required": false, "nullable": true, "max_length": 8000 },
    "tone": { "type": "string", "required": false, "nullable": true, "max_length": 500 },
    "article_length": { "type": "integer", "required": false, "nullable": true, "minimum": 300, "maximum": 20000 },
    "keyword_density": { "type": "string", "required": false, "nullable": true, "max_length": 100 },
    "site_cta": { "type": "string", "required": false, "nullable": true, "max_length": 5000 },
    "language": { "type": "string", "required": false, "nullable": true, "max_length": 100 },
    "preserve_headings": { "type": "boolean", "required": false, "nullable": false, "default": true },
    "preserve_facts": { "type": "boolean", "required": false, "nullable": false, "default": true }
  },
  "output_schema": {
    "type": "markdown",
    "validation": { "not_empty": true, "minimum_length": 300, "reject_provider_preamble": true },
    "normalize": ["trim", "strip_markdown_fence"]
  },
  "template": { "source": "legacy_prompt_content", "system": null, "user": null },
  "validation": { "not_empty": true },
  "retry": { "max": 1, "on": ["empty", "provider_timeout", "truncated"] },
  "logging": { "store_full_prompt": false, "redact_sensitive": true },
  "permissions": { "capability": "text" },
  "metadata": {
    "prompt_concern": "rewrite existing article",
    "workflow_concern": "return revised article markdown",
    "domain_action_concern": "article update belongs to Business Action",
    "ui_concern": "Prompt Editor, Article Editor or Workflow Prompt block"
  },
  "side_effects": []
}
