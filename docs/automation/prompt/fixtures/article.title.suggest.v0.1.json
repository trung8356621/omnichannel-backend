{
  "spec_version": "0.1",
  "key": "article.title.suggest",
  "version": "1.0",
  "name": "Suggest article title",
  "description": "Maps to production PromptHook article.title_suggestion — EXPERIMENTAL until engine contract locked.",
  "enabled": true,
  "classification": "EXPERIMENTAL",
  "legacy_binding": "article_title_suggestion_prompt_id + resources/prompt-hooks/article-title-suggestion.json",
  "model": { "provider": "prompt_connection", "name": "configured", "settings": {} },
  "locale": { "mode": "site", "fallback": "en" },
  "input_schema": {
    "keyword": { "type": "string", "required": true, "max_length": 500 },
    "old_title": { "type": ["string", "null"], "required": false, "nullable": true, "max_length": 300 }
  },
  "output_schema": {
    "type": "text",
    "validation": { "not_empty": true },
    "normalize": ["trim", "strip_markdown_fence", "strip_wrapping_quotes", "first_non_empty_line"]
  },
  "template": {
    "template_key": "prompt_hooks.article_title_suggestion.template",
    "position": "after_prompt"
  },
  "validation": { "not_empty": true },
  "retry": { "max": 0 },
  "logging": { "store_full_prompt": false, "redact_sensitive": true },
  "permissions": { "capability": "text" },
  "metadata": {
    "prompt_concern": "single-line title",
    "workflow_concern": "single hook execute",
    "domain_action_concern": "UI applies title — no auto domain write in hook",
    "ui_concern": "articleTitlePromptHook.js"
  },
  "side_effects": []
}
