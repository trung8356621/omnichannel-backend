{
  "spec_version": "0.1",
  "key": "article.publish.after_ai",
  "version": "1.0",
  "name": "Domain side effect after AI (boundary doc)",
  "description": "NOT a hook — documents that persist is Domain Action / workflow action node.",
  "enabled": true,
  "classification": "KEEP_AS_IS",
  "legacy_binding": "action save_article → PromptTestPublishService; Group 2 bridges",
  "model": { "provider": "n/a", "name": "n/a", "settings": {} },
  "locale": { "mode": "site", "fallback": "en" },
  "input_schema": {
    "article_id": { "type": "integer", "required": true },
    "ai_markdown": { "type": "string", "required": true, "allowed_source": ["previous_outputs"] }
  },
  "output_schema": {
    "type": "structured_object",
    "fields": { "success": "boolean", "message": "string" }
  },
  "template": { "system": "n/a", "user": "n/a" },
  "validation": {},
  "retry": { "max": 0 },
  "logging": { "store_full_prompt": false, "redact_sensitive": true },
  "permissions": { "capability": "domain" },
  "metadata": {
    "prompt_concern": "none",
    "workflow_concern": "action node ordering",
    "domain_action_concern": "article.create / article.content.update / article.seo_meta.update",
    "ui_concern": "project notifications"
  },
  "side_effects": [],
  "note": "Hook engine MUST NOT implement this as a hook. Workflow calls Business Action after hook success."
}
