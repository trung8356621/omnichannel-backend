{
  "spec_version": "0.1",
  "key": "article.outline.generate",
  "version": "0.1.0",
  "status": "experimental",
  "name": "Generate article outline and vocabulary",
  "description": "One provider call returns structured Markdown sections (outline + vocabulary) with separate workflow ports.",
  "enabled": true,
  "classification": "NORMALIZE_NOW",
  "legacy_binding": "outline_heading_regenerator_prompt_id | publish workflow prompt→parse_outline",
  "model": { "provider": "prompt_connection", "name": "configured", "settings": { "temperature": 0.4 } },
  "locale": { "mode": "site", "fallback": "en" },
  "input_schema": {
    "post_title": { "type": "string", "required": true, "nullable": false, "max_length": 500, "allowed_source": ["runtime", "task", "previous_outputs"] },
    "keyword": { "type": "string", "required": false, "nullable": true, "max_length": 500, "allowed_source": ["runtime", "task"] }
  },
  "output_schema": {
    "type": "markdown_sections",
    "sections": [
      {
        "key": "outline",
        "label": "Dàn ý",
        "task": 1,
        "content_type": "markdown",
        "start_marker": "[START_TASK_1_OUTLINE]",
        "end_marker": "[END_TASK_1_OUTLINE]",
        "required": true,
        "output_port": "task_1_outline",
        "normalize": ["trim", "strip_markdown_fence"]
      },
      {
        "key": "vocabulary",
        "label": "Từ vựng",
        "task": 2,
        "content_type": "markdown",
        "start_marker": "[START_TASK_2_VOCABULARY]",
        "end_marker": "[END_TASK_2_VOCABULARY]",
        "required": true,
        "output_port": "task_2_vocabulary",
        "normalize": ["trim", "strip_markdown_fence"]
      }
    ],
    "combined_output": {
      "enabled": true,
      "output_port": "total",
      "preserve_markers": true
    },
    "validation": {
      "reject_unknown_task_markers": true,
      "allow_text_outside_sections": false
    }
  },
  "template": {
    "source": "legacy_prompt_content",
    "system": null,
    "user": null
  },
  "validation": { "not_empty": true },
  "retry": { "max": 1, "on": ["empty", "provider_timeout", "missing_required_section"] },
  "logging": { "store_full_prompt": false, "redact_sensitive": true },
  "permissions": { "capability": "text" },
  "metadata": {
    "prompt_concern": "outline and vocabulary via structured Markdown sections",
    "workflow_concern": "task_1_outline / task_2_vocabulary / total ports",
    "domain_action_concern": "none",
    "ui_concern": "workflow prompt block with multiple output ports",
    "multi_section_exception": true
  },
  "side_effects": []
}
