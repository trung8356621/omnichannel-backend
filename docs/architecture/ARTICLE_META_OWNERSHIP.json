{
  "table": "article_meta",
  "connection": "omi_seo_ai",
  "audited_at": "2026-08-10",
  "rule": "article_meta is escape hatch for sparse/optional/provenance only; queryable lifecycle must be typed tables",
  "schema": ["id", "article_id", "meta_key", "meta_value", "created_at", "updated_at"],
  "keys": [
    {"meta_key": "seo_focus_keyword", "class": "duplicated_sot", "owner": "SEARCH FOUNDATION / SEO", "notes": "prefer keyword attach; keep meta as editor cache until typed cutover"},
    {"meta_key": "seo_meta_description", "class": "sparse_metadata", "owner": "SEO"},
    {"meta_key": "meta_description", "class": "duplicated_sot", "owner": "SEO", "notes": "alias of seo_meta_description"},
    {"meta_key": "seo_title", "class": "duplicated_sot", "owner": "CONTENT", "notes": "mirrors articles.title"},
    {"meta_key": "wp_post_content", "class": "duplicated_sot", "owner": "CONTENT", "notes": "mirrors articles.body"},
    {"meta_key": "wp_slug", "class": "duplicated_sot", "owner": "CONTENT", "notes": "mirrors articles.slug"},
    {"meta_key": "wp_post_type", "class": "duplicated_sot", "owner": "CONTENT", "notes": "mirrors articles.type"},
    {"meta_key": "wp_permalink", "class": "sparse_metadata", "owner": "WORDPRESS"},
    {"meta_key": "wp_entity", "class": "sparse_metadata", "owner": "WORDPRESS"},
    {"meta_key": "wp_taxonomy", "class": "sparse_metadata", "owner": "WORDPRESS"},
    {"meta_key": "wp_featured_image_url", "class": "sparse_metadata", "owner": "MEDIA", "notes": "typed featured via article_media_states preferred"},
    {"meta_key": "wp_product_gallery", "class": "should_typed_table", "owner": "MEDIA"},
    {"meta_key": "wp_product_gallery_attachment_ids", "class": "should_typed_table", "owner": "MEDIA"},
    {"meta_key": "wp_post_images", "class": "sparse_metadata", "owner": "MEDIA"},
    {"meta_key": "category_ids", "class": "should_typed_table", "owner": "CONTENT"},
    {"meta_key": "wp_category_ids", "class": "duplicated_sot", "owner": "CONTENT"},
    {"meta_key": "wp_faqs", "class": "duplicated_sot", "owner": "CONTENT", "notes": "typed FAQ table exists"},
    {"meta_key": "seo_article_outline", "class": "should_typed_table", "owner": "SEO"},
    {"meta_key": "skip_seo_audit", "class": "sparse_metadata", "owner": "SEO", "notes": "align with seo_article_profiles.skip_seo_score"},
    {"meta_key": "seo_rule_violations", "class": "sparse_metadata", "owner": "SEO"},
    {"meta_key": "seo_analyzed_content_hash", "class": "sparse_metadata", "owner": "SEO"},
    {"meta_key": "seo_score_version", "class": "sparse_metadata", "owner": "SEO"},
    {"meta_key": "seo_score_calculated_at", "class": "sparse_metadata", "owner": "SEO"},
    {"meta_key": "content_project_run", "class": "sparse_metadata", "owner": "CONTENT PROJECTS"},
    {"meta_key": "loai_san_pham", "class": "sparse_metadata", "owner": "COMMERCE", "notes": "off catalog"},
    {"meta_key": "gallery_description", "class": "sparse_metadata", "owner": "MEDIA", "notes": "off catalog"},
    {"meta_key": "seo_rank_math_score", "class": "dead_legacy", "owner": "LEGACY/COMPATIBILITY"},
    {"meta_key": "seo_scoring_details", "class": "dead_legacy", "owner": "LEGACY/COMPATIBILITY"},
    {"meta_key": "seo_extracted_links", "class": "dead_legacy", "owner": "LEGACY/COMPATIBILITY"},
    {"meta_key": "wp_post_title", "class": "dead_legacy", "owner": "LEGACY/COMPATIBILITY"},
    {"meta_key": "virtual_comments", "class": "dead_legacy", "owner": "COMMERCE", "notes": "migrate to article_product_reviews"},
    {"meta_key": "seo_article_faqs", "class": "dead_legacy", "owner": "CONTENT"}
  ]
}
