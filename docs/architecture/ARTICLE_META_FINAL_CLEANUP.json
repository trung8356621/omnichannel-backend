{
  "table": "article_meta",
  "connection": "omi_seo_ai",
  "audited_at": "2026-08-10",
  "source": "docs/architecture/ARTICLE_META_OWNERSHIP.json",
  "rule": "Classify each meta_key for final cutover: KEEP_METADATA | MIGRATE_TO_TYPED_OWNER | COMPAT_READ_ONLY | DEAD_DELETE",
  "class_map": {
    "sparse_metadata": "KEEP_METADATA",
    "should_typed_table": "MIGRATE_TO_TYPED_OWNER",
    "duplicated_sot": "COMPAT_READ_ONLY",
    "dead_legacy": "DEAD_DELETE"
  },
  "keys": [
    {"meta_key": "seo_focus_keyword", "disposition": "COMPAT_READ_ONLY", "owner": "SEARCH FOUNDATION / SEO", "from_class": "duplicated_sot", "notes": "prefer keyword attach; editor cache until typed cutover"},
    {"meta_key": "seo_meta_description", "disposition": "KEEP_METADATA", "owner": "SEO", "from_class": "sparse_metadata"},
    {"meta_key": "meta_description", "disposition": "COMPAT_READ_ONLY", "owner": "SEO", "from_class": "duplicated_sot", "notes": "alias of seo_meta_description"},
    {"meta_key": "seo_title", "disposition": "DEAD_DELETE", "owner": "CONTENT", "from_class": "duplicated_sot", "notes": "Task 7 §N cutover — articles.title SoT"},
    {"meta_key": "wp_post_content", "disposition": "COMPAT_READ_ONLY", "owner": "CONTENT", "from_class": "duplicated_sot", "notes": "mirrors articles.body; cache retained while body may be null"},
    {"meta_key": "wp_slug", "disposition": "DEAD_DELETE", "owner": "CONTENT", "from_class": "duplicated_sot", "notes": "Task 7 §N cutover — articles.slug SoT"},
    {"meta_key": "wp_post_type", "disposition": "DEAD_DELETE", "owner": "CONTENT", "from_class": "duplicated_sot", "notes": "Task 7 §N cutover — articles.type SoT"},
    {"meta_key": "wp_permalink", "disposition": "KEEP_METADATA", "owner": "WORDPRESS", "from_class": "sparse_metadata"},
    {"meta_key": "wp_entity", "disposition": "KEEP_METADATA", "owner": "WORDPRESS", "from_class": "sparse_metadata"},
    {"meta_key": "wp_taxonomy", "disposition": "KEEP_METADATA", "owner": "WORDPRESS", "from_class": "sparse_metadata"},
    {"meta_key": "wp_featured_image_url", "disposition": "KEEP_METADATA", "owner": "MEDIA", "from_class": "sparse_metadata", "notes": "typed featured via article_media_states preferred; keep sparse until readers cut over"},
    {"meta_key": "wp_product_gallery", "disposition": "MIGRATE_TO_TYPED_OWNER", "owner": "MEDIA", "from_class": "should_typed_table"},
    {"meta_key": "wp_product_gallery_attachment_ids", "disposition": "MIGRATE_TO_TYPED_OWNER", "owner": "MEDIA", "from_class": "should_typed_table"},
    {"meta_key": "wp_post_images", "disposition": "KEEP_METADATA", "owner": "MEDIA", "from_class": "sparse_metadata"},
    {"meta_key": "category_ids", "disposition": "MIGRATE_TO_TYPED_OWNER", "owner": "CONTENT", "from_class": "should_typed_table"},
    {"meta_key": "wp_category_ids", "disposition": "COMPAT_READ_ONLY", "owner": "CONTENT", "from_class": "duplicated_sot"},
    {"meta_key": "wp_faqs", "disposition": "COMPAT_READ_ONLY", "owner": "CONTENT", "from_class": "duplicated_sot", "notes": "typed FAQ table exists"},
    {"meta_key": "seo_article_outline", "disposition": "MIGRATE_TO_TYPED_OWNER", "owner": "SEO", "from_class": "should_typed_table"},
    {"meta_key": "skip_seo_audit", "disposition": "KEEP_METADATA", "owner": "SEO", "from_class": "sparse_metadata", "notes": "align with seo_article_profiles.skip_seo_score"},
    {"meta_key": "seo_rule_violations", "disposition": "KEEP_METADATA", "owner": "SEO", "from_class": "sparse_metadata"},
    {"meta_key": "seo_analyzed_content_hash", "disposition": "KEEP_METADATA", "owner": "SEO", "from_class": "sparse_metadata"},
    {"meta_key": "seo_score_version", "disposition": "KEEP_METADATA", "owner": "SEO", "from_class": "sparse_metadata"},
    {"meta_key": "seo_score_calculated_at", "disposition": "KEEP_METADATA", "owner": "SEO", "from_class": "sparse_metadata"},
    {"meta_key": "content_project_run", "disposition": "KEEP_METADATA", "owner": "CONTENT PROJECTS", "from_class": "sparse_metadata"},
    {"meta_key": "loai_san_pham", "disposition": "KEEP_METADATA", "owner": "COMMERCE", "from_class": "sparse_metadata", "notes": "off catalog"},
    {"meta_key": "gallery_description", "disposition": "KEEP_METADATA", "owner": "MEDIA", "from_class": "sparse_metadata", "notes": "off catalog"},
    {"meta_key": "seo_rank_math_score", "disposition": "DEAD_DELETE", "owner": "LEGACY/COMPATIBILITY", "from_class": "dead_legacy"},
    {"meta_key": "seo_scoring_details", "disposition": "DEAD_DELETE", "owner": "LEGACY/COMPATIBILITY", "from_class": "dead_legacy"},
    {"meta_key": "seo_extracted_links", "disposition": "DEAD_DELETE", "owner": "LEGACY/COMPATIBILITY", "from_class": "dead_legacy"},
    {"meta_key": "wp_post_title", "disposition": "DEAD_DELETE", "owner": "LEGACY/COMPATIBILITY", "from_class": "dead_legacy"},
    {"meta_key": "virtual_comments", "disposition": "MIGRATE_TO_TYPED_OWNER", "owner": "COMMERCE", "from_class": "dead_legacy", "notes": "override: migrate to article_product_reviews before delete"},
    {"meta_key": "seo_article_faqs", "disposition": "DEAD_DELETE", "owner": "CONTENT", "from_class": "dead_legacy", "notes": "typed FAQ table is SoT"}
  ]
}
